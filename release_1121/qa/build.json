  "derived_changed": [
    {
      "file": "lx0506.nss",
      "kind": "last_text",
      "ordinal": 3,
      "before": "《주께서 횃불이 되어 나를 비추시고, 주를 기쁘시게 할 길을 알리시어, 가르쳐 주소서》",
      "after": "《주께서 횃불이 되어 나를 비추시고, 주를 기쁘시게 할 길을 알려 주시고, 가르쳐 주소서》",
      "changed": true
    },
    {
      "file": "lx0506.nss",
      "kind": "last_text",
      "ordinal": 4,
      "before": "《깨끗하고 부드러운 침상을 만듭시다. 내 마음의 성전에서 편히 쉬시도록》",
      "after": "《정결하고 부드러운 침상을 마련하리라. 내 마음의 성전에서 잠드실 수 있도록》",
      "changed": true
    },
    {
      "file": "lx0506.nss",
      "kind": "last_text",
      "ordinal": 5,
      "before": "《목자들이여, 두려워하지 말라. 천사들이 알리고 있도다. 이 연약한 어린아이야말로 우리의 위로와 기쁨. 마침내는 사탄을 물리치고, 영원한 평화를 가져다주실 분》",
      "after": "《목자들이여, 두려워하지 말라. 천사들이 알리고 있도다. 이 연약한 어린아이야말로 우리의 위로이자 기쁨. 마침내는 사탄을 물리치고, 영원한 평화를 가져다주실 분》",
      "changed": true
    },
    {
      "file": "lx0506.nss",
      "kind": "oratorio",
      "ordinal": 6,
      "before": "주를 기쁘시게 할 길을 알리시어&, 가르쳐 주소서》",
      "after": "주를 기쁘시게 할 길을 알려 주시고, 가르쳐 주소서》",
      "changed": true
